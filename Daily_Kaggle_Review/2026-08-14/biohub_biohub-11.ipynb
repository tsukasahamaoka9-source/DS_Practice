   "source": [
    "import os\n",
    "\n",
    "BIOHUB_PRESET = 'forward_acceleration_lookahead'\n",
    "BIOHUB_SCORE_AXIS = ('add a one-frame geometric lookahead that rewards a candidate target only when '\n",
    "                     'it supports a smooth continuation into the following frame; all Biohub 159B '\n",
    "                     'ranker evidence and graph repair remain fixed')\n",
    "\n",
    "# --- ギャップクロージング（検出漏れフレームをまたいでトラックをつなぐ） ---\n",
    "os.environ[\"BIOHUB_GAP_CLOSE_MAX_GAP\"] = \"2\"          # 何フレーム分の欠落まで許容するか\n",
    "os.environ[\"BIOHUB_GAP_CLOSE_UM\"] = \"5.8\"              # つなぐ際の最大移動距離(µm)\n",
    "os.environ[\"BIOHUB_GAP_DENSITY_ADAPTIVE\"] = \"1\"        # 密度に応じて許容距離を調整するか\n",
    "\n",
    "# --- 細胞分裂(mitosis)の安全制約 ---\n",
    "os.environ[\"BIOHUB_SAFE_DIV_MAX_UM\"] = \"4.66\"          # 親→娘の最大距離(µm)\n",
    "os.environ[\"BIOHUB_SAFE_DIV_SISTER_MAX_UM\"] = \"8.5\"    # 姉妹細胞同士の最大距離(µm)\n",
    "os.environ[\"BIOHUB_OUTPUT_KEEP_DIVISION_COMPONENTS\"] = \"1\"\n",
    "\n",
    "# --- モーション再リンク(速度を考慮した再接続) ---\n",
    "os.environ[\"BIOHUB_MOTION_RELINK_TIGHT_UM\"] = \"6.0\"\n",
    "os.environ[\"BIOHUB_MOTION_RELINK_RELAXED_UM\"] = \"10.0\"\n",
    "os.environ[\"BIOHUB_MOTION_RELINK_VELOCITY_WEIGHT\"] = \"0.5\"\n",
    "\n",
    "# --- ILP(整数計画法)によるフレーム間対応付けの重み ---\n",
    "os.environ[\"BIOHUB_ILP_APPEARANCE_WEIGHT\"] = \"0.0\"\n",
    "os.environ[\"BIOHUB_ILP_DISAPPEARANCE_WEIGHT\"] = \"1.5\"\n",
    "os.environ[\"BIOHUB_ILP_DIVISION_WEIGHT\"] = \"1.0\"\n",
    "\n",
    "# --- 学習済みlocal-association ranker(候補対応のスコアリング) ---\n",
    "os.environ[\"BIOHUB_USE_LOCAL_ASSOCIATION_RANKER\"] = \"1\"\n",
    "os.environ[\"BIOHUB_LOCAL_RANKER_MODE\"] = \"full_motion_assignment\"\n",
    "os.environ[\"BIOHUB_LOCAL_RANKER_FULL_WEIGHT\"] = \"0.85\"\n",
    "\n",
    "# --- 今回のプリセット固有: 1フレーム先読みで「滑らかな継続」を評価 ---\n",
    "os.environ[\"BIOHUB_USE_FORWARD_ACCELERATION_LOOKAHEAD\"] = \"1\"\n",
    "os.environ[\"BIOHUB_FORWARD_LOOKAHEAD_MAX_ACCEL_UM\"] = \"4.0\"\n",
    "os.environ[\"BIOHUB_FORWARD_LOOKAHEAD_MAX_BONUS\"] = \"0.20\"\n",
    "\n",
    "# (元notebookにはこの他にも短寿命トラック救済・ギャップ密度推定・線形フィット平滑化など\n",
    "#  100個近いパラメータが続きますが、ここでは代表値のみ抜粋しています)\n",
    "\n",
    "print(\"BIOHUB_PRESET:\", BIOHUB_PRESET)"

    "print(\"BIOHUB_SCORE_AXIS:\", BIOHUB_SCORE_AXIS)\n"
