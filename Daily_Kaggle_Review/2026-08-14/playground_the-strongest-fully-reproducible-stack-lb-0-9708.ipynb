    "Rf = np.column_stack([norm_rank(O[:, j]) for j in range(O.shape[1])])\n",
    "Rt = np.column_stack([norm_rank(T[:, j]) for j in range(T.shape[1])])\n",
    "Bf, Bt = np.hstack([Rf, logit(O)]), np.hstack([Rt, logit(T)])\n",
    "\n",
    "wg = LogisticRegression(C=1.0, max_iter=2000).fit(Bf, y).coef_.ravel()\n",
    "pg_te = Bt @ wg\n",
    "\n",
    "nm_te = test[FE].isna().sum(axis=1).to_numpy()\n",
    "c_te, m_te = (nm_te == 0).astype(np.float64), (nm_te >= 4).astype(np.float64)\n",
    "\n",
    "def regime_feats_any(R_half, B, cc, mm):\n",
    "    d = R_half.std(axis=1)\n",
    "    d = (d - d.mean()) / (d.std() + 1e-12)\n",
    "    agg = np.column_stack([R_half.mean(1), R_half.std(1),\n",
    "                            R_half.max(1) - R_half.min(1), cc, mm])\n",
    "    return np.column_stack([B, B * cc[:, None], B * mm[:, None], B * d[:, None], agg])\n",
    "\n",
    "sc = StandardScaler().fit(regime_feats_any(Rf, Bf, c_fl, m_fl))\n",
    "lr = LogisticRegression(C=1.0, max_iter=2000).fit(\n",
    "    sc.transform(regime_feats_any(Rf, Bf, c_fl, m_fl)), y)\n",
    "pr_te = sc.transform(regime_feats_any(Rt, Bt, c_te, m_te)) @ lr.coef_.ravel()\n",
    "\n",
    "p = rank01((1 - W) * rank01(pg_te) + W * rank01(pr_te))\n",
    "sub = pd.read_csv(os.path.join(COMP, \"sample_submission.csv\"))\n",
    "sub.iloc[:, 1] = p\n",
    "assert np.isfinite(p).all()\n",
    "sub.to_csv(\"submission.csv\", index=False)\n",
    "print(\"submission.csv written -\", sub.shape, \"- the attached score is this file\")\n",
